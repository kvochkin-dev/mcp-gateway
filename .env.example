# MCP Gateway — Production Config

# GigaChat API Key (get from https://developer.sber.ru/)
GIGACHAT_API_KEY=your_gigachat_api_key_here

# YandexGPT API Key (get from AI Platform / YandexGPT console)
YANDEXGPT_API_KEY=your_yandexgpt_api_key_here

# Yandex Folder ID (for YandexGPT authentication)
YANDEXGPT_FOLDER_ID=your_yandex_folder_id_here

# Server Configuration
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Optional: Ollama endpoint for local fallback
# OLLAMA_BASE_URL=http://localhost:11434
